#!/usr/bin/python3
"""qa-gh: the scheduled QA sweep agent's only GitHub reader.

  qa-gh issue list --label qa-sweep --state open
  qa-gh pr view 11533 --json title,body

Sends its argv to the runner's gh broker (scripts/qa/gh-broker.py) on the
loopback port in QA_GH_PORT and prints the answer. The broker, not this client,
decides what is allowed and always pins the repository; see gh-broker.py.
"""
import json
import os
import socket
import sys


def main():
    port = os.environ.get("QA_GH_PORT", "")
    if not port.isdigit():
        sys.stderr.write("qa-gh: QA_GH_PORT is not set (only available inside the scheduled QA sweep)\n")
        return 2
    try:
        s = socket.create_connection(("127.0.0.1", int(port)), timeout=120)
        s.sendall((json.dumps({"argv": sys.argv[1:]}) + "\n").encode())
        buf = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        resp = json.loads(buf.decode("utf-8"))
    except (OSError, ValueError) as e:
        sys.stderr.write("qa-gh: broker unavailable: %s\n" % e)
        return 2
    sys.stdout.write(resp.get("stdout", ""))
    sys.stderr.write(resp.get("stderr", ""))
    rc = resp.get("rc", 1)
    return rc if isinstance(rc, int) and 0 <= rc < 256 else 1


if __name__ == "__main__":
    sys.exit(main())
