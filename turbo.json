{
  "$schema": "https://turbo.build/schema.json",
  // `dev` is persistent in 13 packages, and turbo needs more slots than persistent tasks.
  // Must be a string: turbo's schema rejects a number here.
  "concurrency": "20",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "BREEZE_APP_DB_PASSWORD",
    "POSTGRES_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:check-drift": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
