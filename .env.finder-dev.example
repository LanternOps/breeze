# Template for .env.finder-dev (gitignored — never commit real values).
#
# Copy this file to .env.finder-dev and fill in real values:
#   cp .env.finder-dev.example .env.finder-dev
#
# Point a local `api` service at it with an `env_file:` entry in your own
# Compose override, or export the value into your shell before `pnpm dev`.

# Voyage AI embeddings key, used by the built-in Workspace extension's
# content-preview vector-embedding step (ee/workspace/src/content/embedder.ts).
# Optional: with no key the extension runs with embeddings disabled.
# Get one at https://dash.voyageai.com.
VOYAGE_API_KEY=changeme
