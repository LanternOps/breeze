<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for breeze-agent ONLY. breeze-backup,
  breeze-desktop-helper and breeze-watchdog are signed with
  helpers-macos.entitlements.plist and must not gain these exceptions.

  com.apple.security.cs.disable-library-validation:
    loads libopenh264, which is not signed by our team.

  com.apple.security.cs.allow-unsigned-executable-memory (#10375):
    the YARA engine (yaraxwasm on wazero) compiles WebAssembly to machine
    code in anonymous memory mapped read-write, then mprotected read-execute,
    without MAP_JIT. Without this entitlement the kernel SIGKILLs the agent
    (CODESIGNING "Invalid Page") the first time a security scan runs.
    allow-jit does NOT cover this: it only applies to MAP_JIT regions.
    If this key is removed, yarac.EnsureEngine refuses to start the engine
    and scans fall back to the built-in signatures.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
