#!/bin/sh
# NU Agent - preinstall
#
# Stop the services before the payload replaces the binaries underneath them.
#
# Order matters: the watchdog supervises the agent and will restart it, so it has
# to go first or we race it. Both are tolerated as absent — this same package is
# used for first installs and for repairs.
set -u

# RustDesk is deliberately NOT stopped here. On an upgrade the payload replaces
# /Applications/RustDesk.app while a session may be live; macOS keeps the running
# process on its already-open inodes, so it carries on with the old bundle and
# nobody gets disconnected. Booting out com.carriez.RustDesk_service would kill
# the exact remote session a tech might be installing THROUGH. The consequence is
# that the new bundle and the relay config postinstall writes take effect on the
# next RustDesk restart (or reboot), not immediately.

launchctl bootout system/com.nodesunlimited.watchdog 2>/dev/null || true
launchctl bootout system/com.nodesunlimited.agent 2>/dev/null || true

# Per-user helper, if a console user is logged in.
CONSOLE_UID=$(stat -f %u /dev/console 2>/dev/null || echo "")
if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" != "0" ]; then
  launchctl bootout "gui/$CONSOLE_UID/com.nodesunlimited.desktop-helper-user" 2>/dev/null || true
fi

exit 0
