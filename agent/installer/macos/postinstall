#!/bin/bash
# Breeze Agent macOS .pkg postinstall script
# Runs as root after the installer places files on disk.

set -e

# Install-location rules shared with the running agent (#7211).
# shellcheck source=install-location.sh
. "$(dirname "$0")/install-location.sh"
# ensure_breeze_group: create or repair the IPC socket group (#7829). The same
# file the daemon embeds (agent/internal/sessionbroker/ensure_ipc_group.sh);
# build-pkg.sh copies it here.
# shellcheck source=../../internal/sessionbroker/ensure_ipc_group.sh
. "$(dirname "$0")/ensure_ipc_group.sh"

# The payload stages the root-daemon binaries here, never in /usr/local/bin:
# on the hosts where /usr/local/bin is unsafe, a non-root identity could
# otherwise swap them before this script copies them into place.
STAGING_DIR="/Library/Breeze/pkg-staging"
DESKTOP_HELPER_BINARY="/usr/local/bin/breeze-desktop-helper"
CONFIG_DIR="/Library/Application Support/Breeze"
LOG_DIR="/Library/Logs/Breeze"
DAEMON_PLIST="/Library/LaunchDaemons/com.breeze.agent.plist"
WATCHDOG_PLIST="/Library/LaunchDaemons/com.breeze.watchdog.plist"
DESKTOP_USER_PLIST="/Library/LaunchAgents/com.breeze.desktop-helper-user.plist"
DESKTOP_LOGINWINDOW_PLIST="/Library/LaunchAgents/com.breeze.desktop-helper-loginwindow.plist"

# Pick the install directory BEFORE placing anything: choose_bin_dir keys
# off whether an agent already lives in the trusted directory.
BIN_DIR="$(choose_bin_dir)"
echo "Installing Breeze daemon binaries to $BIN_DIR"
if [ "$BIN_DIR" = "$TRUSTED_BIN_DIR" ]; then
    if ! legacy_dir_is_safe "$LEGACY_BIN_DIR"; then
        explain_unsafe_legacy_dir "$LEGACY_BIN_DIR"
    fi
    ensure_trusted_bin_dir
fi
BINARY="$BIN_DIR/breeze-agent"
WATCHDOG_BINARY="$BIN_DIR/breeze-watchdog"

install_binary "$STAGING_DIR/breeze-agent" "$BINARY"
install_binary "$STAGING_DIR/breeze-backup" "$BIN_DIR/breeze-backup"
if [ -f "$STAGING_DIR/breeze-watchdog" ]; then
    install_binary "$STAGING_DIR/breeze-watchdog" "$WATCHDOG_BINARY"
fi
rm -rf "$STAGING_DIR"

# The shipped daemon plists name /usr/local/bin. Repoint them when the
# binaries went to the trusted directory. Copies an earlier release left in
# /usr/local/bin are removed by the agent and watchdog themselves on their
# next start, once they see their plist no longer names that path.
# The desktop-helper LaunchAgents are deliberately NOT repointed: the helper
# is never relocated, and stays at /usr/local/bin/breeze-desktop-helper.
if [ "$BIN_DIR" != "$LEGACY_BIN_DIR" ]; then
    point_plist_at "$DAEMON_PLIST" "$LEGACY_BIN_DIR" "$BIN_DIR" breeze-agent
    point_plist_at "$WATCHDOG_PLIST" "$LEGACY_BIN_DIR" "$BIN_DIR" breeze-watchdog
fi

# Create directories
mkdir -p "$CONFIG_DIR"
chmod 0700 "$CONFIG_DIR"
mkdir -p "$LOG_DIR"
chmod 0755 "$LOG_DIR"

# Remove quarantine attribute (binary is notarized but raw
# Mach-O binaries cannot have the ticket stapled). The daemon binaries were
# already cleared by install_binary.
xattr -d com.apple.quarantine "$DESKTOP_HELPER_BINARY" 2>/dev/null || true

# Set permissions
chmod 0755 "$DESKTOP_HELPER_BINARY"
chmod 0644 "$DAEMON_PLIST"
chmod 0644 "$DESKTOP_USER_PLIST"
chmod 0644 "$DESKTOP_LOGINWINDOW_PLIST"

# breeze_group_has_member reports whether $1 is in the breeze group.
breeze_group_has_member() {
    dscl . -read /Groups/breeze GroupMembership 2>/dev/null | tr ' ' '\n' | grep -qx "$1"
}

# Add every logged-in GUI user to the breeze group so their desktop helper can
# dial the 0660 root:breeze IPC socket. Mirrors the equivalent loop in
# scripts/install/install-linux.sh. Without this the socket is group-owned by a
# group nobody is in, and Standard (non-admin) users' helpers are denied
# (#3133/#3134/#3137).
#
# Runs BEFORE the LaunchAgents are bootstrapped below: a helper process inherits
# its group list when it starts, so membership has to exist first.
add_console_users_to_breeze_group() {
    local uid username
    # This script runs under `set -e`. The `|| continue` on the id lookup is
    # load-bearing: a bare failing assignment would abort the whole postinstall.
    # (A failing `[ ... ] && continue` would NOT — set -e exempts a command that
    # is part of an && list other than the last one.)
    for uid in $(ps -axo uid= -o comm= | grep -i '[lL]oginwindow' | awk '{print $1}' | sort -u); do
        # macOS gives human accounts UIDs from 500 up; below that are system and
        # service accounts, which never run a Breeze desktop helper.
        if ! [ "$uid" -ge 500 ] 2>/dev/null; then
            continue
        fi
        username=$(id -un "$uid" 2>/dev/null) || continue
        if [ -z "$username" ]; then
            continue
        fi
        if breeze_group_has_member "$username"; then
            continue
        fi
        dscl . -append /Groups/breeze GroupMembership "$username" 2>/dev/null || true
        # Verify by re-reading rather than trusting dscl's exit status, so the
        # success line below cannot claim a membership that did not take.
        if breeze_group_has_member "$username"; then
            echo "Added $username to the breeze group for desktop-helper socket access"
        else
            echo "Warning: could not add $username to the breeze group; that user's desktop helper will be denied the agent socket" >&2
        fi
    done
}

# Create the breeze group for IPC socket access, or give a GID-less one left by
# an earlier failed install its GID (#7829). Deliberately not fatal: this
# script is also the unattended self-update path, the agent daemon is not
# bootstrapped yet, and aborting here would leave the whole agent down over a
# group that only user-session helpers need. The daemon retries the same rule
# on every start (sessionbroker.EnsureIPCGroup) and logs an error if the socket
# still cannot get its group.
if ! ensure_breeze_group; then
    echo "Warning: could not ensure the breeze group; desktop helpers will be denied the agent socket until the agent repairs it on a later start" >&2
fi
add_console_users_to_breeze_group

# Group-own the config directory so anything created inside it inherits the
# breeze group under BSD semantics. The daemon chowns agent.sock explicitly on
# every start (sessionbroker.setupSocket); this is defence in depth. Mode is
# unchanged — agent.yaml is deliberately world-readable for the user helper
# (#2483) and secrets.yaml stays 0600 root-only.
chgrp breeze "$CONFIG_DIR" 2>/dev/null || \
    echo "Warning: could not group-own $CONFIG_DIR as breeze" >&2

# Load the agent daemon (starts via RunAtLoad), THEN the watchdog. A watchdog
# loaded first finds no agent and, on its first process tick, bootstraps the
# agent itself, racing this script's own bootout/bootstrap (#7831).
# `breeze-agent service install` uses the same agent-first order. Failing to
# load the agent fails the install; bootstrap_system_daemon prints why and how
# to recover.
if ! bootstrap_system_daemon com.breeze.agent "$DAEMON_PLIST"; then
    exit 1
fi
# The watchdog only supervises; the agent runs without it, so a failure here
# warns rather than failing an install whose agent is already up.
if [ -f "$WATCHDOG_PLIST" ]; then
    if ! bootstrap_system_daemon com.breeze.watchdog "$WATCHDOG_PLIST"; then
        echo "Warning: the watchdog did not load; the agent was loaded but has no supervisor" >&2
    fi
fi

# Load the user helper LaunchAgent for all currently logged-in GUI users.
# The plist lives in /Library/LaunchAgents/ so launchd will auto-load it
# for future logins, but we need to bootstrap it now for anyone already
# logged in so Remote Desktop works immediately after install.
for uid in $(ps -axo uid= -o comm= | grep -i '[lL]oginwindow' | awk '{print $1}' | sort -u); do
    # Skip root (uid 0) — LaunchAgents are user-session only
    [ "$uid" = "0" ] && continue
    # Unload any stale instance first
    launchctl bootout "gui/$uid/com.breeze.desktop-helper-user" 2>/dev/null || true
    # Bootstrap into the user's GUI domain
    launchctl bootstrap "gui/$uid" "$DESKTOP_USER_PLIST" 2>/dev/null || true
done

launchctl bootstrap loginwindow "$DESKTOP_LOGINWINDOW_PLIST" 2>/dev/null || true

echo "Breeze Agent installed and started."
exit 0
