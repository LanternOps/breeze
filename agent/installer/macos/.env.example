# RustDesk relay — NU self-hosted hbbs/hbbr on Titan01 (Coolify service nu-rmm).
#
# Template. Copy to .env (gitignored) and fill in the real values.
#
# Source of truth: nodes-unlimited-rmm/docs/rustdesk-production.md
# Refresh the key (ops only):
#   ssh root@<titan01> 'cat /var/lib/docker/volumes/<vol>_rustdesk-data/_data/id_ed25519.pub'

# ONE variable for the host, no port. Titan01 public IP today because Coolify env
# uses the IP; when DNS is intentional this is the only line that changes.
NU_RUSTDESK_RELAY_HOST=relay.example.com

NU_RUSTDESK_ID_PORT=21116
NU_RUSTDESK_RELAY_PORT=21117

# PUBLIC key (id_ed25519.pub) — safe to ship inside the installer.
# The private id_ed25519 must NEVER be referenced or embedded.
NU_RUSTDESK_PUBLIC_KEY=<base64 contents of id_ed25519.pub>
