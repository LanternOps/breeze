[Unit]
Description=NU Agent User Session Helper (Nodes Unlimited RMM)
Documentation=https://github.com/breeze-rmm/breeze
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nu-agent user-helper
Restart=on-failure
RestartSec=10
Environment=DISPLAY=%I

# Sandbox: no network, limited filesystem
ProtectSystem=strict
PrivateNetwork=true
NoNewPrivileges=true
ProtectHome=read-only
ReadOnlyPaths=/
# MUST stay /var/run/breeze. This is the IPC socket directory the agent actually
# creates and the helper actually connects to — see internal/ipc/auth_linux.go,
# the nu-watchdog unit, service/tmpfiles.d, and RuntimeDirectory=breeze in
# nu-agent.service. A branding pass rewrote this one path to
# /var/run/nodesunlimited; because this unit is ProtectSystem=strict, a
# ReadWritePaths entry pointing at a nonexistent directory fails sandbox setup
# and the helper never starts at all.
ReadWritePaths=/var/run/breeze /tmp

[Install]
WantedBy=graphical-session.target
