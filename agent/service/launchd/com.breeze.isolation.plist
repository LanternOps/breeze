<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.breeze.isolation</string>

    <key>ProgramArguments</key>
    <array>
        <string>__RECOVERY_PATH__</string>
        <string>boot-apply</string>
        <string>--data-dir</string>
        <string>__DATA_DIR__</string>
    </array>

    <key>UserName</key>
    <string>root</string>

    <key>GroupName</key>
    <string>wheel</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Library/Logs/Breeze/isolation-recovery.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/Breeze/isolation-recovery.log</string>
</dict>
</plist>
