# Development Dockerfile for API with hot-reloading

# YARA rule pre-check binary (#10306) — the same stage as docker/Dockerfile.api
# and apps/api/Dockerfile, so dev and wt-stacks can publish rule sets. Without
# it every rule save answers `precheckUnavailable` (services/yaraPrecheck.ts).
# Tag must equal agent/go.mod's `go` directive (check-go-version-pins.sh).
FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS yarac
ARG TARGETOS
ARG TARGETARCH
ENV GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0
WORKDIR /src/agent
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/cmd/breeze-yarac ./cmd/breeze-yarac
COPY agent/internal ./internal
RUN GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -ldflags "-s -w" -o /out/breeze-yarac ./cmd/breeze-yarac

FROM node:24-alpine

# Built on Alpine above, so it is linked against musl's loader and runs here
# as-is. A copy cross-built on macOS/glibc would not (ENOENT on exec).
COPY --from=yarac /out/breeze-yarac /usr/local/bin/breeze-yarac

# Install pnpm (pinned to match prod / packageManager field)
RUN npm install -g pnpm@10.34.5

# Set working directory
WORKDIR /app

# Copy workspace configuration
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY patches ./patches
COPY turbo.json tsconfig.json ./

# Copy package.json files for dependency installation
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/extension-sdk/package.json ./packages/extension-sdk/
# apps/api statically imports the built-in @breeze/ext-workspace extension
# (builtinRegistry.ts), which depends on extension-web-sdk and, as a
# devDependency, extension-testkit. This image installs devDependencies
# (bare `pnpm install` below), so every manifest here must be present or
# pnpm aborts with ERR_PNPM_WORKSPACE_PKG_NOT_FOUND.
COPY packages/extension-web-sdk/package.json ./packages/extension-web-sdk/
COPY packages/extension-testkit/package.json ./packages/extension-testkit/
COPY ee/workspace/package.json ./ee/workspace/

# Install all dependencies (including devDependencies for development)
RUN pnpm install

# Copy source code (will be overridden by volume mounts in dev)
COPY apps/api ./apps/api
COPY packages/shared ./packages/shared
COPY packages/extension-sdk ./packages/extension-sdk
COPY packages/extension-web-sdk ./packages/extension-web-sdk
COPY packages/extension-testkit ./packages/extension-testkit
# Built-in extension source + manifest.json + migrations (no build:web here --
# builtinExtensions.ts tolerates a missing dist/web outside production, just
# warns and keeps the extension's server routes active).
COPY ee/workspace ./ee/workspace

# Set working directory to api
WORKDIR /app/apps/api

# Expose port
EXPOSE 3001

# Sync dependencies on container start so package.json changes don't crash hot-reload.
CMD ["sh", "-lc", "pnpm install --prefer-offline --no-frozen-lockfile && pnpm dev"]
