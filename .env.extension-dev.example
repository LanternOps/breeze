# Template for .env.extension-dev (gitignored — never commit real values).
#
# Copy this file to .env.extension-dev and fill in real values:
#   cp .env.extension-dev.example .env.extension-dev
#
# Referenced by a local, untracked docker-compose.<name>.override.yml's
# `env_file:` entry for the `api` service — see extensions/README.md for the
# override pattern.

# Voyage AI embeddings key, used by an extension's vector-embedding step.
# Get one at https://dash.voyageai.com.
VOYAGE_API_KEY=changeme

# Origins of extension client panels (add-in panes served from their own
# origin) allowed to import() extension web-bundle modules from the
# digest-addressed asset route — and ONLY that route. Comma-separated exact
# origins; empty or unset means no cross-origin access. Wildcards are refused.
EXTENSION_CLIENT_PANEL_ORIGINS=https://localhost:3004
