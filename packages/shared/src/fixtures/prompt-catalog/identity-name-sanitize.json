    {
      "name": "plain name",
      "input": "Northwind IT",
      "expected": "Northwind IT"
    },
    {
      "name": "leading and trailing spaces trimmed",
      "input": "  Northwind IT  ",
      "expected": "Northwind IT"
    },
    {
      "name": "internal whitespace collapsed",
      "input": "Northwind \t\n  IT",
      "expected": "Northwind IT"
    },
    {
      "name": "newline becomes a space",
      "input": "Northwind\nIT",
      "expected": "Northwind IT"
    },
    {
      "name": "CRLF becomes one space",
      "input": "Northwind\r\nIT",
      "expected": "Northwind IT"
    },
    {
      "name": "no-break space",
      "input": "Northwind\u00a0IT",
      "expected": "Northwind IT"
    },
    {
      "name": "ideographic space",
      "input": "Northwind\u3000IT",
      "expected": "Northwind IT"
    },
    {
