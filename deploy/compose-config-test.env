REDIS_PASSWORD=compose-config-placeholder
JWT_SECRET=compose-config-placeholder-at-least-32-characters
AGENT_ENROLLMENT_SECRET=compose-config-placeholder-at-least-32-characters
APP_ENCRYPTION_KEY=compose-config-placeholder-at-least-32-characters
MFA_ENCRYPTION_KEY=compose-config-placeholder-at-least-32-characters
ENROLLMENT_KEY_PEPPER=compose-config-placeholder-at-least-32-characters
MFA_RECOVERY_CODE_PEPPER=compose-config-placeholder-at-least-32-characters
PARTNER_API_CURSOR_SIGNING_KEY=cgYy+vOPRtXfjto5BCAA8WoY2gnseZ96bWkLMIsw2XU=
RELEASE_ARTIFACT_MANIFEST_PUBLIC_KEYS=compose-config-public-key-placeholder
IS_HOSTED=false
REMOTE_ACCESS_ADMISSION_MODE=closed
REMOTE_WS_AUTH_MODE=post_upgrade
REMOTE_WS_REDIS_TOPOLOGY=standalone-single-primary
REMOTE_WS_LEGACY_TICKET_WRITER_DRAINED_AT=2026-01-01T00:00:00.000Z
REMOTE_WS_LEGACY_VIEWER_ISSUER_DRAINED_AT=2026-01-01T00:00:00.000Z
BILLING_SERVICE_API_KEY=compose-config-placeholder
TURN_SECRET=compose-config-placeholder
