# =============================================================================
# NU RMM (Breeze) — Coolify service environment — EXAMPLE (no real secrets)
# =============================================================================
# One line per env key currently set on the Coolify Service
# (uuid zsv4uxqp8xoozq1c069b9oco). Secrets are CHANGE_ME — pull real values
# from the Coolify UI (Environment Variables tab), NEVER from this file.
#
# NOTE on Coolify-generated keys: SERVICE_FQDN_* and SERVICE_URL_* are
# generated/managed by Coolify from the service's domain settings. Do not
# hand-edit them; set the gateway FQDN in the Coolify UI and let Coolify
# derive them.
#
# NOTE on writing envs: envs must be created via the Coolify REST API or UI
# (Laravel encrypted casts). Never insert env rows with raw psql — the values
# will be stored unencrypted/corrupt. See bootstrap-coolify.sh.
# =============================================================================

# ---------------------------------------------------------------------------
# Images / versions (interpolated into docker-compose.nu.yml; pull_policy is
# `never`, so these tags must already exist locally on titan01)
# ---------------------------------------------------------------------------
BREEZE_API_IMAGE=nu/breeze-api:git-c89be0d1
BREEZE_WEB_IMAGE=nu/breeze-web:git-c89be0d1
BREEZE_VERSION=0.104.0
APP_VERSION=0.104.0

# ---------------------------------------------------------------------------
# Public URLs / domain
# ---------------------------------------------------------------------------
BREEZE_DOMAIN=rmm.nodesunlimited.com
PUBLIC_WEB_URL=https://rmm.nodesunlimited.com
PUBLIC_API_URL=https://rmm.nodesunlimited.com
PUBLIC_APP_URL=https://rmm.nodesunlimited.com
DASHBOARD_URL=https://rmm.nodesunlimited.com
CORS_ALLOWED_ORIGINS=https://rmm.nodesunlimited.com

# ---------------------------------------------------------------------------
# Gateway (Caddy) / proxy trust
# LANDMINE: TRUSTED_PROXY_CIDRS must be exact /32s. The API refuses broad
# private ranges and crash-loops. Keep in sync with the gateway's pinned IPs
# (nu-rmm: BREEZE_CADDY_IP, coolify: BREEZE_CADDY_COOLIFY_IP).
# ---------------------------------------------------------------------------
BREEZE_CADDY_IP=172.29.0.10
BREEZE_DOCKER_SUBNET=172.29.0.0/24
# Not yet present in prod envs — the compose defaults it to 10.0.1.250; set it
# explicitly if the coolify network's IPAM requires a different free address.
#BREEZE_CADDY_COOLIFY_IP=10.0.1.250
CADDY_TRUSTED_PROXIES=10.0.1.0/24
CADDY_CLIENT_IP_HEADERS=X-Forwarded-For X-Real-IP
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=172.29.0.10/32,10.0.1.25/32
TRUST_CF_CONNECTING_IP=false
FORCE_HTTPS=false

# ---------------------------------------------------------------------------
# breeze-api: core / database / redis
# Postgres is a SEPARATE Coolify resource (container r75rs3j2yea71ss08hqjgx8x).
# The API auto-migrates on boot (AUTO_MIGRATE=true).
# ---------------------------------------------------------------------------
IS_HOSTED=false
AUTO_MIGRATE=true
DATABASE_URL=CHANGE_ME
DATABASE_URL_APP=CHANGE_ME
BREEZE_APP_DB_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
REDIS_HOST=nc2218t7tr7kde8e1z3tw7a4
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=CHANGE_ME   # redis://:<password>@<host>:6379 form
BREEZE_ALLOW_UNAUTH_REDIS=

# ---------------------------------------------------------------------------
# breeze-api: secrets / crypto
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME
APP_ENCRYPTION_KEY=CHANGE_ME
MFA_ENCRYPTION_KEY=CHANGE_ME
ENROLLMENT_KEY_PEPPER=CHANGE_ME
MFA_RECOVERY_CODE_PEPPER=CHANGE_ME
AGENT_ENROLLMENT_SECRET=CHANGE_ME
PARTNER_API_CURSOR_SIGNING_KEY=CHANGE_ME
METRICS_SCRAPE_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# breeze-api: remote access / websockets
# ---------------------------------------------------------------------------
REMOTE_ACCESS_ADMISSION_MODE=open
REMOTE_WS_AUTH_MODE=post_upgrade
REMOTE_WS_REDIS_TOPOLOGY=standalone-single-primary
EVENT_PERMISSION_EPOCH_MODE=compat

# ---------------------------------------------------------------------------
# breeze-api: agent/viewer binaries (served from the breeze-api-data volume)
# ---------------------------------------------------------------------------
BINARY_SOURCE=local
AGENT_BINARY_DIR=/data/binaries/agent
VIEWER_BINARY_DIR=/data/binaries/viewer
BINARY_VERSION_FILE=/data/binaries/agent/VERSION
RELEASE_ARTIFACT_MANIFEST_PUBLIC_KEYS=CHANGE_ME

# ---------------------------------------------------------------------------
# breeze-api: S3 (Garage on titan01)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://168.119.184.198:3900
S3_REGION=Germany-1
S3_BUCKET=breeze-rmm
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PRESIGN_TTL=900

# ---------------------------------------------------------------------------
# breeze-api: registration / bootstrap admin
# ---------------------------------------------------------------------------
ENABLE_REGISTRATION=false
BREEZE_BOOTSTRAP_ADMIN_EMAIL=admin@nodesunlimited.com
BREEZE_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BREEZE_BOOTSTRAP_ADMIN_NAME=Nodes Unlimited Admin

# ---------------------------------------------------------------------------
# breeze-api: integrations
# ---------------------------------------------------------------------------
GOOGLE_WORKSPACE_ENABLED=true
M365_ENABLED=true
NU_ENTRA_CLIENT_ID=3fc8f6c9-8ece-42b3-9e39-307875d684a4
NU_ENTRA_TENANT_ID=912ae395-664d-4988-9468-0bf1bc879fdb
NU_ENTRA_ISSUER=https://login.microsoftonline.com/912ae395-664d-4988-9468-0bf1bc879fdb   # verify exact suffix (e.g. /v2.0) against live value
ANTHROPIC_API_KEY=CHANGE_ME
VOYAGE_API_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# breeze-api: email (Resend)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=system@nodesunlimited.com

# ---------------------------------------------------------------------------
# breeze-api: TURN (unused today — empty in prod)
# ---------------------------------------------------------------------------
TURN_HOST=
TURN_PORT=3478
TURN_REALM=
TURN_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# breeze-api: WebAuthn (passkeys)
# ---------------------------------------------------------------------------
WEBAUTHN_ORIGIN=https://rmm.nodesunlimited.com
WEBAUTHN_RP_ID=rmm.nodesunlimited.com
WEBAUTHN_RP_NAME=Nodes Unlimited RMM

# ---------------------------------------------------------------------------
# RustDesk (hbbs / hbbr / rustdesk-api)
# ---------------------------------------------------------------------------
RUSTDESK_RELAY_HOST=168.119.184.198
RUSTDESK_API_LANG=en
RUSTDESK_API_RUSTDESK_ID_SERVER=168.119.184.198:21116
RUSTDESK_API_RUSTDESK_RELAY_SERVER=168.119.184.198:21117
RUSTDESK_API_RUSTDESK_API_SERVER=
RUSTDESK_API_RUSTDESK_KEY=CHANGE_ME
RUSTDESK_API_ADMIN_TITLE=Nodes Unlimited Remote

# ---------------------------------------------------------------------------
# Coolify-generated (SERVICE_FQDN_* / SERVICE_URL_*) — managed by Coolify from
# the service's domain settings; listed for completeness only.
# ---------------------------------------------------------------------------
SERVICE_FQDN_GATEWAY=rmm.nodesunlimited.com
SERVICE_FQDN_GATEWAY_80=rmm.nodesunlimited.com:80
SERVICE_FQDN_RUSTDESKAPI=rustdeskapi-zsv4uxqp8xoozq1c069b9oco.blooming-brands.com
SERVICE_FQDN_RUSTDESKAPI_21114=rustdeskapi-zsv4uxqp8xoozq1c069b9oco.blooming-brands.com:21114
SERVICE_URL_GATEWAY=https://rmm.nodesunlimited.com
SERVICE_URL_GATEWAY_80=https://rmm.nodesunlimited.com:80
SERVICE_URL_RUSTDESKAPI=https://rustdeskapi-zsv4uxqp8xoozq1c069b9oco.blooming-brands.com
SERVICE_URL_RUSTDESKAPI_21114=https://rustdeskapi-zsv4uxqp8xoozq1c069b9oco.blooming-brands.com
