diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..334f959be7aba9fb5c00970c8592149f10328218 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -159,6 +159,15 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (terminated)
       return queryError(q, Errors.connection('CONNECTION_DESTROYED', options))
 
+    // breeze patch (#8143): begin() issues its ROLLBACK on the reserved
+    // connection after that connection's socket has already closed (a backend
+    // terminated by the wedged-backend reclaimer). Upstream buffered it and
+    // threw from the write Immediate, leaving `chunk` and `nextWriteTimer` set,
+    // so the reconnect's StartupMessage was never flushed. Fail it instead, and
+    // return true so the pool leaves this connection in `closed`.
+    if (!socket)
+      return queryError(q, Errors.connection('CONNECTION_CLOSED', options)), true
+
     if (stream)
       return queryError(q, Errors.generic('COPY_IN_PROGRESS', 'You cannot execute queries during copy'))
 
@@ -172,11 +181,21 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      const accepted = write(toBuffer(q))
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
+      // breeze patch (#8143): a transaction's BEGIN must reserve this
+      // connection even when the write hit backpressure or the pipeline limit.
+      // Upstream short-circuits past onexecute, so begin() ran with no
+      // connection and this connection went back to the pool INSIDE the BEGIN.
+      // Returning false matches the normal path (onexecute returns undefined),
+      // so the caller parks the connection in `full` exactly as before.
+      if (q.options.onexecute) {
+        q.options.onexecute(connection)
+        return false
+      }
+      return accepted
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
@@ -427,6 +446,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       error(Errors.connection('CONNECTION_DESTROYED', options))
 
     clearImmediate(nextWriteTimer)
+    chunk = nextWriteTimer = null
     if (socket) {
       socket.removeListener('data', data)
       socket.removeListener('connect', connected)
@@ -440,6 +460,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    chunk = nextWriteTimer = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
@@ -453,6 +474,14 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       return reconnect()
 
     !hadError && (query || sent.length) && error(Errors.connection('CONNECTION_CLOSED', options, socket))
+    // breeze patch (#8143): per-socket protocol state dies with the socket.
+    // A FATAL ErrorResponse (57P01 from pg_terminate_backend) that arrived for
+    // the in-flight query has no ReadyForQuery to clear it, so upstream kept
+    // `errorResponse` (and `query`) and failed the FIRST query of the next
+    // socket with the dead backend's error. Every query here is already
+    // rejected: by error() just above, or by the socket 'error' handler.
+    query = results = errorResponse = null
+    result = new Result()
     closedTime = performance.now()
     hadError && options.shared.retries++
     delay = (typeof backoff === 'function' ? backoff(options.shared.retries) : backoff) * 1000
