---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import { tServer } from '../lib/i18n/server';
import { currentSecurityContacts, getAuthFooterLinks } from '../lib/securityContact';

interface Props {
  title?: string;
  titleKey?: string;
}

const { title, titleKey } = Astro.props;
const pageTitle = titleKey ? tServer(Astro.locals.locale, titleKey) : title;
const metaDescription = tServer(Astro.locals.locale, 'layout.metaDescription');
const tagline = tServer(Astro.locals.locale, 'authLayout.tagline');
// Operator abuse/security links (#8872): server-side env, empty unless configured.
const footerLinks = getAuthFooterLinks(currentSecurityContacts(), Astro.url.host);
---

<!DOCTYPE html>
<html lang={Astro.locals.locale ?? 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Apply persisted appearance preferences before first paint. Auth pages can
      be reached by hard redirects after token expiry, so they cannot rely on
      the main app layout having installed the theme swap listener.
    -->
    <script is:inline src="/theme-bootstrap.js"></script>
    <title>{pageTitle} | Breeze RMM</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background antialiased">
    <div class="flex min-h-screen items-center justify-center px-4 py-12">
      <div class="w-full max-w-md space-y-8">
        <div class="text-center">
          <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-lg bg-primary/15">
            <svg width="18" height="18" viewBox="0 0 64 64" fill="none" class="text-primary" aria-hidden="true">
              <path d="M12 22C12 22 20 22 28 22C36 22 40 16 48 16C52 16 54 18 54 20C54 22 52 24 48 24C44 24 42 22 42 22" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M8 34C8 34 18 34 30 34C42 34 46 28 52 28C55 28 57 30 57 32C57 34 55 36 52 36C48 36 46 34 46 34" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M14 46C14 46 22 46 32 46C40 46 44 40 50 40C53 40 55 42 55 44C55 46 53 48 50 48C46 48 44 46 44 46" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h1 class="mt-3 text-xl font-bold tracking-tight">Breeze</h1>
          <p class="mt-1 text-sm text-muted-foreground">{tagline}</p>
        </div>

        <slot />

        {footerLinks.length > 0 && (
          <footer class="flex justify-center gap-4 text-xs text-muted-foreground">
            {footerLinks.map((link) => (
              <a href={link.href} class="underline-offset-4 hover:text-foreground hover:underline">
                {tServer(Astro.locals.locale, /* i18n-dynamic */ link.key)}
              </a>
            ))}
          </footer>
        )}
      </div>
    </div>
  </body>
</html>
