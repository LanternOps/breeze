// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`OperatorTaskPlan — onboarding stages (W07 R2b) > 7. a one-approval task renders byte-identical to R1 1`] = `"<div data-testid="task-plan" class="space-y-4"><section data-testid="task-plan-revision-1" class="space-y-3 rounded-md border p-3"><header class="flex flex-wrap items-center gap-2 text-sm"><span class="font-semibold">Revision 1</span><span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-xs font-medium border-success/40 bg-success/10 text-success">Approved</span><span class="text-xs text-muted-foreground">2 changes</span><span class="text-xs text-muted-foreground">Approved <time></span></header><p class="text-xs text-muted-foreground">Changes run one at a time in the numbered order, across services.</p><div data-testid="task-plan-provider-google"><h5 class="text-xs font-medium uppercase text-muted-foreground">Google Workspace</h5><ul class="mt-1 space-y-2"><li data-testid="task-plan-effect-0" class="rounded-md border px-3 py-2 text-sm"><div class="flex flex-wrap items-start gap-2"><span class="font-mono text-xs text-muted-foreground">#1</span><span class="flex-1">google_set_vacation for dana@example.com</span><span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-xs">Not started / unknown</span></div><div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted-foreground"><span>For: Dana Smith</span><span>Account: dana@example.com</span><span>Safe to repeat</span></div></li></ul></div><div data-testid="task-plan-provider-m365"><h5 class="text-xs font-medium uppercase text-muted-foreground">Microsoft 365</h5><ul class="mt-1 space-y-2"><li data-testid="task-plan-effect-1" class="rounded-md border px-3 py-2 text-sm"><div class="flex flex-wrap items-start gap-2"><span class="font-mono text-xs text-muted-foreground">#2</span><span class="flex-1">m365_disable_user for dana@example.com</span><span class="inline-flex items-center rounded-md border px-1.5 py-0.5 text-xs">Succeeded</span></div><div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted-foreground"><span>For: Dana Smith</span><span>Account: dana@example.com</span><span>Safe to repeat</span></div></li></ul></div></section></div>"`;
