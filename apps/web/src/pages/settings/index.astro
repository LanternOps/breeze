---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import SettingsCatalog from '../../components/settings/SettingsCatalog';
import { tServer } from '../../lib/i18n/server';

const locale = Astro.locals.locale;
---

<DashboardLayout titleKey="titles.settings">
  <div class="space-y-6">
    <div>
      <h1 class="text-xl font-semibold tracking-tight">{tServer(locale, 'settingsIndex.heading')}</h1>
      <p class="text-muted-foreground">{tServer(locale, 'settingsIndex.description')}</p>
    </div>

    <!--
      #6220: every settings screen is listed here (lib/settingsCatalog.ts), grouped
      and searchable, and gated by the same predicate the sidebar uses. Add new
      settings pages to the catalogue, not to this file.
    -->
    <SettingsCatalog client:load />
  </div>
</DashboardLayout>
