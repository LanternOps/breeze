---
import Layout from '../../../layouts/Layout.astro';
import AuthOverlay from '../../../components/auth/AuthOverlay';
import ToastContainer from '../../../components/shared/Toast';
import RemoteToolsPage from '../../../components/remote/RemoteToolsPage';
import { tServer } from '../../../lib/i18n/server';

const { deviceId } = Astro.params;
const locale = Astro.locals.locale;
---

<Layout titleKey="titles.remoteTerminalDevice">
  <!-- #3984: this page used bare Layout.astro with no AuthOverlay, so an
       AuthThrottledError from a throttled /auth/refresh here went unhandled —
       no waiting mask, no recovery, just a broken remote session. -->
  <AuthOverlay client:load />
  <!-- #9154: bare Layout.astro has no toast host; without this every
       showToast/runAction failure toast on this page was silently dropped. -->
  <ToastContainer client:load />
  <div class="h-[calc(100vh-1rem)]">
    <RemoteToolsPage
      deviceId={deviceId!}
      deviceName={tServer(locale, 'remoteTerminalPage.loadingDeviceName')}
      deviceOs="windows"
      initialTab="terminal"
      showClose={true}
      client:only="react"
    >
      <div slot="fallback" class="flex h-full items-center justify-center">
        <p class="text-sm text-muted-foreground">{tServer(locale, 'remoteTerminalPage.loading')}</p>
      </div>
    </RemoteToolsPage>
  </div>
</Layout>
