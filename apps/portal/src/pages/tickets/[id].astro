---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { isPortalPageDisabled, redirectToPortalHomeAfterDisabled } from '../../lib/visibilityGate';
import { redirectToLoginAfter401 } from '../../lib/session';
import TicketDetails from '../../components/portal/TicketDetails';
import { portalApi, type PortalApproval } from '../../lib/api';
import { buildServerApiConfig } from '../../lib/server';

const { id } = Astro.params;
const response = await portalApi.getTicket(id!, buildServerApiConfig(Astro.request));

if (response.statusCode === 401) {
  // Dead session: clear the stale cookie and come back here after sign-in.
  return redirectToLoginAfter401(Astro);
}

// #2345 — the enable_tickets gate 403s with code PORTAL_TICKETS_DISABLED;
// bounce to the portal home instead of rendering a dead page. Other 403s
// (e.g. "Account is not active") keep the previous behavior: fall through and
// render the page with the API error inline.
if (isPortalPageDisabled(response)) {
  // PORTAL_TICKETS_DISABLED — bounce to the ungated home, never to /devices,
  // which is itself gated on Self-service (#4932 follow-up).
  return redirectToPortalHomeAfterDisabled(Astro);
}

// Customer work approval (#8200): surface a request on this ticket that the
// viewer can decide. Best-effort: a failed read just means no banner.
let pendingApproval: {
  id: string;
  approval: Pick<PortalApproval, 'trigger' | 'ticketNumber' | 'ask'>;
} | null = null;
if (response.data) {
  const approvals = await portalApi.getApprovals(buildServerApiConfig(Astro.request), { pendingOnly: true });
  if (approvals.statusCode === 200) {
    const match = (approvals.data?.data ?? []).find((a) => a.ticketId === id && a.canDecide);
    // Pass the raw ask: the island formats it client-side in the viewer's time zone.
    if (match) pendingApproval = { id: match.id, approval: { trigger: match.trigger, ticketNumber: match.ticketNumber, ask: match.ask } };
  }
}
---

<PortalLayout title="Ticket">
  <TicketDetails client:load ticket={response.data ?? null} error={response.error} statusCode={response.statusCode} pendingApproval={pendingApproval} />
</PortalLayout>
