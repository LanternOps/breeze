---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { BackupOverview } from '../../components/portal/BackupOverview';
import { BackupDeviceTable } from '../../components/portal/BackupDeviceTable';
import { ErrorNotice } from '../../components/portal/ui';
import { portalApi } from '../../lib/api';
import { buildServerApiConfig } from '../../lib/server';
import { redirectToLoginAfter401 } from '../../lib/session';

const config = buildServerApiConfig(Astro.request);
const [overview, devices] = await Promise.all([
  portalApi.getBackupOverview(config),
  portalApi.getBackupDevices({ page: 1, limit: 100 }, config),
]);

if (overview.statusCode === 401 || devices.statusCode === 401) {
  return redirectToLoginAfter401(Astro);
}

// The overview's `no_data` keys on a passed verification, not on backups. The
// device ledger is what actually knows whether anything has been backed up, so
// the page tells the summary rather than letting it contradict the rows below.
const backupDevices = devices.data?.data ?? [];
const hasBackupActivity = backupDevices.some(
  (device) => device.configured && device.lastRestorePointAt !== null
);
---

<PortalLayout title="Backups">
  {
    overview.data ? (
      <BackupOverview overview={overview.data} hasBackupActivity={hasBackupActivity} />
    ) : (
      <div data-testid="portal-backup-error">
        <ErrorNotice>{overview.error ?? 'Backup information is unavailable.'}</ErrorNotice>
      </div>
    )
  }
  <BackupDeviceTable
    devices={backupDevices}
    total={devices.data?.pagination.total}
    error={devices.error}
  />
</PortalLayout>
