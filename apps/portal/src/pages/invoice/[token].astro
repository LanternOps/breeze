---
import PublicDocumentLayout from '../../layouts/PublicDocumentLayout.astro';
import PublicInvoiceView from '../../components/portal/PublicInvoiceView';
import { portalApi } from '../../lib/api';
import { buildServerApiConfig } from '../../lib/server';

const { token } = Astro.params;
const response = await portalApi.getPublicInvoice(token!, buildServerApiConfig(Astro.request));

// An invalid/expired/reset token returns 401 from the API. This page is public,
// so we must NOT redirect an anonymous customer to the portal login — render
// PublicInvoiceView's own generic invalid-link fallback instead (and suppress
// the raw 401 text, which would otherwise read "Session expired").
const initial = response.data?.data ?? null;
const error = response.statusCode === 401 ? undefined : response.error;
const partnerName = initial?.branding?.partnerName;
const number = initial?.invoice?.invoiceNumber;
const title = partnerName
  ? `${number ?? 'Invoice'} — ${partnerName}`
  : (number ?? 'Invoice');
---

<PublicDocumentLayout title={title}>
  <PublicInvoiceView token={token!} initial={initial} error={error} client:load />
</PublicDocumentLayout>
