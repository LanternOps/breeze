---
// PUBLIC invoice page — deliberately NO SSR fetch (unlike quote/[token].astro):
// the portal container's server-side API calls carry no client IP, so every
// SSR load would share one 'unknown'-keyed slot of the /invoices/public
// isolated rate bucket — one bot hammering an expired link could 429 every
// customer's invoice page region-wide. PublicInvoiceView fetches client-side,
// where the customer's own IP keys the bucket.
import PublicDocumentLayout from '../../layouts/PublicDocumentLayout.astro';
import PublicInvoiceView from '../../components/portal/PublicInvoiceView';

const { token } = Astro.params;
---

<PublicDocumentLayout title="Invoice">
  <PublicInvoiceView token={token!} client:load />
</PublicDocumentLayout>
