---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/basePath';
import { loadPortalBranding } from '../lib/server';
import { buildDocAccentCss } from '../lib/docAccent';

interface Props {
  title: string;
}

const { title } = Astro.props;
// The first screen a customer ever sees showed a generic padlock and the words
// "Customer Portal", so someone arriving from an emailed link had no way to
// confirm they were in the right place. Branding is unauthenticated-safe here:
// the endpoint resolves by host/org, and these are details the MSP publishes.
const branding = await loadPortalBranding(Astro.request);
const accentCss = buildDocAccentCss(branding.primaryColor);
const cspNonce = Astro.locals.cspNonce;
const portalName = branding.name || 'Customer Portal';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Secure access to your IT services" />
    <link rel="icon" type="image/svg+xml" href={branding.faviconUrl || withBase('/favicon.svg')} />
    <title>{title} | {portalName}</title>
    {accentCss && <style nonce={cspNonce} set:html={accentCss}></style>}
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-background antialiased">
    <main class="flex min-h-dvh items-center justify-center px-4 py-12">
      <div class="settle-in w-full max-w-md space-y-8">
        <div class="text-center">
          {branding.logoUrl ? (
            <img
              src={branding.logoUrl}
              alt={portalName}
              class="mx-auto h-12 w-auto max-w-[220px] object-contain"
            />
          ) : (
            <div class="doc-accent-bg mx-auto h-1 w-12 rounded-full" aria-hidden="true"></div>
          )}
          <h1 class="mt-5 font-display text-[1.75rem] font-semibold leading-tight tracking-tight text-foreground">{portalName}</h1>
          <p class="mt-2 text-sm text-muted-foreground">Sign in to review proposals, pay invoices, and reach your IT team.</p>
        </div>

        <slot />

        {(branding.supportEmail || branding.supportPhone) && (
          <p class="text-center text-sm text-muted-foreground">
            Trouble signing in?
            {branding.supportEmail && (
              <a href={`mailto:${branding.supportEmail}`} class="ml-1 font-medium text-primary-on-tint hover:underline">
                {branding.supportEmail}
              </a>
            )}
            {branding.supportPhone && (
              <a href={`tel:${branding.supportPhone}`} class="ml-2 font-medium text-primary-on-tint hover:underline">
                {branding.supportPhone}
              </a>
            )}
          </p>
        )}
      </div>
    </main>
  </body>
</html>
