# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Sentry build-time config.
# `.env.sentry-build-plugin` holds SENTRY_AUTH_TOKEN — a REAL secret, unlike the
# DSN — and is auto-loaded by sentry-xcode.sh / sentry-xcode-debug-files.sh at
# build time. The root .gitignore only matches a file named exactly `.env`, so
# this needs its own rule. The `.example` file is tracked deliberately.
.env.sentry-build-plugin
!.env.sentry-build-plugin.example
# Generated by the @sentry/react-native config plugin during prebuild.
sentry.options.json

# Android Firebase config (#3639). NOT committed: `expo prebuild --platform
# android` copies this file (referenced by app.json's android.googleServicesFile)
# into the generated native project, and the config plugin only resolves it at
# prebuild time — so it needs to exist on disk before an Android build, not in
# git. `scripts/write-google-services.mjs` writes it from the
# GOOGLE_SERVICES_JSON build-time secret; see that script and STORE_SUBMISSION.md
# for the injection contract. The `.example` file is tracked deliberately.
google-services.json
!google-services.json.example

# typescript
*.tsbuildinfo

# generated native folders — `expo prebuild` regenerates both, so they stay out
# of git (Continuous Native Generation).
#
# `/ios/*` rather than `/ios` on purpose: git cannot re-include a path whose
# parent directory is excluded, so the `!` line below only works against the
# wildcard form. Xcode Cloud requires ci_scripts to sit beside the
# .xcworkspace, which lands it inside this otherwise-ignored directory.
/ios/*
!/ios/ci_scripts
/android
