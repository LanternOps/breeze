# Development Environment - Copy to .env.dev
# Usage: docker compose -f docker-compose.dev.yml --env-file .env.dev up

# Authentication (generate real values)
JWT_SECRET=dev-only-change-me-openssl-rand-base64-64
AGENT_ENROLLMENT_SECRET=dev-only-change-me-openssl-rand-hex-32

# Browser app API URL (must match the hostname used by the web app for Lax/Strict cookies)
PUBLIC_API_URL=http://localhost:3001

# Cookie policy for local development (same-site localhost)
AUTH_COOKIE_SAME_SITE=Lax
PORTAL_COOKIE_SAME_SITE=Lax
# For cross-site cookie auth, use None over HTTPS only:
# AUTH_COOKIE_SAME_SITE=None
# PORTAL_COOKIE_SAME_SITE=None

# If running API with NODE_ENV=production locally, include exact frontend origins (with ports)
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322

# Optional: AI Brain
ANTHROPIC_API_KEY=
# Hardware warranty lookups (optional; see .env.example for details)
DELL_CLIENT_ID=
DELL_CLIENT_SECRET=
LENOVO_API_KEY=
LENOVO_WARRANTY_ENABLED=

# Optional: Email (leave empty to disable)
RESEND_API_KEY=
EMAIL_FROM=noreply@breeze.local

# Optional: Monitoring
METRICS_SCRAPE_TOKEN=dev-metrics-token

# Host interface the stack's ports are published on (#9382). The default is
# loopback, so Postgres, Redis, MinIO, the API and the web dev server are
# reachable from this machine only. Set 0.0.0.0 ONLY if another machine must
# reach the stack -- and change the passwords in this file and the fixed
# breeze/breeze Postgres and minioadmin/minioadmin credentials in
# docker-compose.dev.yml first, because they are published as they stand.
BREEZE_DEV_BIND_ADDR=127.0.0.1

# Password for this stack's Redis (#9382). It had none, so the opt-out above
# would otherwise expose an unauthenticated Redis. Throwaway by default, to
# match the fixed Postgres credentials; change it along with the rest if you
# publish beyond loopback.
BREEZE_DEV_REDIS_PASSWORD=breeze
